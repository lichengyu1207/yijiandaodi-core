#!/bin/bash
# Pre-commit Hook - Git源码泄露检测
# 安装: cp tools/pre-commit .git/hooks/
# 权限: chmod +x .git/hooks/pre-commit

echo "运行Git泄露检测..."

# 获取项目根目录
PROJECT_ROOT="$(git rev-parse --show-toplevel)"

# 运行检测工具
python "$PROJECT_ROOT/tools/git_leak_detector.py" "$PROJECT_ROOT" --staged

# 检查退出码
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ 检测到敏感信息泄露风险！"
    echo "请修复后再提交，或使用 git commit --no-verify 跳过检查"
    echo ""
    exit 1
fi

echo "✅ 未检测到泄露风险"
exit 0
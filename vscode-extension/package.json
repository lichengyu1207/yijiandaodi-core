{
  "name": "yijiandaodi-interceptor",
  "displayName": "一鉴到底 - AI 安全拦截器",
  "description": "像 360 一样实时拦截 AI Agent 的风险操作",
  "version": "1.0.0",
  "publisher": "yijiandaodi",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Security"
  ],
  "keywords": [
    "ai",
    "security",
    "interceptor",
    "cursor",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "logo.png",
  "contributes": {
    "commands": [
      {
        "command": "yijiandaodi.toggleInterceptor",
        "title": "一鉴到底: 开启/关闭拦截器"
      },
      {
        "command": "yijiandaodi.checkCurrentFile",
        "title": "一鉴到底: 检测当前文件"
      },
      {
        "command": "yijiandaodi.showStatus",
        "title": "一鉴到底: 显示状态"
      }
    ],
    "configuration": {
      "title": "一鉴到底",
      "properties": {
        "yijiandaodi.apiEndpoint": {
          "type": "string",
          "default": "http://localhost:9092",
          "description": "一鉴到底 API 端点"
        },
        "yijiandaodi.autoBlock": {
          "type": "boolean",
          "default": true,
          "description": "自动拦截严重风险操作"
        },
        "yijiandaodi.showNotification": {
          "type": "boolean",
          "default": true,
          "description": "显示拦截通知"
        },
        "yijiandaodi.agents": {
          "type": "array",
          "default": ["cursor", "copilot", "trae", "claude", "chatgpt"],
          "description": "监控的 AI Agent 列表"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "yijiandaodi.checkCurrentFile",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ]
    },
    "statusBarItems": [
      {
        "command": "yijiandaodi.showStatus",
        "text": "$(shield) 一鉴到底",
        "tooltip": "一鉴到底 - AI 安全拦截器"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yijiandaodi/vscode-extension"
  },
  "license": "MIT",
  "homepage": "https://yijiandaodi.com"
}
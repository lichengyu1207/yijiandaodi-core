{
  "manifest_version": 3,
  "name": "一鉴到底 - AI创作保护助手",
  "version": "1.0.0",
  "description": "记录创作操作、本地存指纹、一键导出证据链报告。这是一款创作过程记录工具，非监控软件，数据归用户所有。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "一鉴到底"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["http://localhost:3001/*", "http://localhost:8000/*", "https://yijiandaodi.com/*"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "popup/*", "PRIVACY_POLICY.html", "TERMS_OF_USE.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "privacy_policy": "PRIVACY_POLICY.html",
  "permissions_reason": {
    "storage": "本地存储录制数据，数据归用户所有",
    "activeTab": "获取当前标签页信息，仅限用户正在创作的页面",
    "scripting": "在创作平台页面注入录制脚本",
    "tabs": "检测当前标签页的创作平台",
    "webNavigation": "检测页面跳转，保持录制状态连续",
    "alarms": "定时清理过期数据"
  },
  "not_monitoring_software": true
}